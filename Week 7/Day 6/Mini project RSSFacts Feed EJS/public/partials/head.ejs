<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle === 'string' ? pageTitle : 'Fact Feed' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root { color-scheme: light; --ink: #142b35; --paper: #f2f5f1; --accent: #d55d35; --line: #d9e1dc; }
    body { background: var(--paper); color: var(--ink); font-family: Georgia, 'Times New Roman', serif; }
    .navbar { background: var(--ink); }
    .navbar-brand, .nav-link { color: #f8f5ec; }
    .navbar-brand { font-weight: 700; }
    .nav-link:hover, .navbar-brand:hover { color: #f2a17a; }
    .page-shell { max-width: 960px; }
    .page-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; }
    .eyebrow { color: var(--accent); font: 700 .75rem/1.2 system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase; }
    .post { border-top: 1px solid var(--line); padding: 1.5rem 0; }
    .post h2 { font-size: 1.55rem; }
    .post a { color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 4px; }
    .post-meta { color: #53666c; font: .875rem/1.5 system-ui, sans-serif; }
    .search-panel { background: #fff; border: 1px solid var(--line); border-radius: 4px; }
    .btn-primary { --bs-btn-bg: var(--accent); --bs-btn-border-color: var(--accent); --bs-btn-hover-bg: #b94c2c; --bs-btn-hover-border-color: #b94c2c; }
    footer { border-top: 1px solid var(--line); color: #53666c; font: .875rem/1.5 system-ui, sans-serif; }
  </style>
</head>
<body>