<%- include('../partials/head', { pageTitle: 'Search facts' }) %>
<%- include('../partials/header') %>
<main class="container page-shell py-5">
  <p class="eyebrow mb-2">Find something fascinating</p>
  <h1 class="page-title mb-4">Search facts</h1>
  <section class="search-panel p-3 p-md-4 mb-5" aria-label="Fact search">
    <form action="/search/title" method="post" class="row g-3 align-items-end mb-4">
      <div class="col-md-9">
        <label for="title" class="form-label">Search by title</label>
        <input class="form-control" id="title" name="title" type="search" value="<%= searchType === 'title' ? searchValue : '' %>" placeholder="Enter a word or phrase">
      </div>
      <div class="col-md-3 d-grid">
        <button class="btn btn-primary" type="submit">Search title</button>
      </div>
    </form>
    <form action="/search/category" method="post" class="row g-3 align-items-end">
      <div class="col-md-9">
        <label for="category" class="form-label">Browse by category</label>
        <select class="form-select" id="category" name="category" required>
          <option value="" disabled <%= searchType !== 'category' ? 'selected' : '' %>>Choose a category</option>
          <% categories.forEach((category) => { %>
            <option value="<%= category %>" <%= searchType === 'category' && searchValue === category ? 'selected' : '' %>><%= category %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3 d-grid">
        <button class="btn btn-primary" type="submit">Search category</button>
      </div>
    </form>
  </section>
  <% if (searchType) { %>
    <h2 class="h4 mb-3">Results for <%= searchValue %></h2>
  <% } %>
  <%- include('../partials/posts', { posts, error, emptyMessage: searchType ? 'No matching facts found.' : 'Use either form above to find facts.' }) %>
</main>
<%- include('../partials/footer') %>