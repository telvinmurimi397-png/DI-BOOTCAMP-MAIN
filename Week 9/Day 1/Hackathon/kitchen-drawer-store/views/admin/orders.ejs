<%- include('../partials/header') %>

<h1>Manage Orders</h1>
<p><a class="btn btn-outline" href="/admin">Dashboard</a></p>

<% if (!orders.length) { %>
  <p class="empty">No orders yet.</p>
<% } else { %>
  <table class="cart-table">
    <thead><tr><th>#</th><th>Customer</th><th>Date</th><th>Ship To</th><th>Total</th><th>Status</th></tr></thead>
    <tbody>
      <% orders.forEach((o) => { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= o.email %></td>
          <td><%= o.created_at %></td>
          <td><%= o.shipping_city %></td>
          <td>$<%= o.total.toFixed(2) %></td>
          <td>
            <form method="post" action="/admin/orders/<%= o.id %>/status" class="status-form">
              <select name="status" onchange="this.form.submit()">
                <% ['pending','shipped','delivered','cancelled'].forEach((s) => { %>
                  <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
