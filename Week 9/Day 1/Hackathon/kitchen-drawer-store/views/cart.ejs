<%- include('partials/header') %>

<h1>Your Cart</h1>

<% if (!cart.length) { %>
  <p class="empty">Your cart is empty. <a href="/">Browse the shop →</a></p>
<% } else { %>
  <table class="cart-table">
    <thead>
      <tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
      <% cart.forEach((item) => { %>
        <tr>
          <td><span class="row-emoji"><%= item.emoji %></span> <%= item.name %></td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td><%= item.qty %></td>
          <td>$<%= (item.price * item.qty).toFixed(2) %></td>
          <td>
            <form method="post" action="/cart/remove">
              <input type="hidden" name="id" value="<%= item.id %>">
              <button class="link-btn" type="submit">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr><td colspan="3"><strong>Total</strong></td><td colspan="2"><strong>$<%= total.toFixed(2) %></strong></td></tr>
    </tfoot>
  </table>

  <div class="cart-actions">
    <a href="/" class="btn btn-outline">&larr; Continue shopping</a>
    <a href="/checkout" class="btn">Proceed to Checkout</a>
  </div>
<% } %>

<%- include('partials/footer') %>
