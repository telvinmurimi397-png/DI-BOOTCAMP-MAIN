<%- include('partials/header') %>

<section class="hero">
  <h1>Everyday tools for better cooking</h1>
  <p>Practical kitchen utensils for prep, cooking and baking.</p>
</section>

<form class="search-bar" method="get" action="/shop">
  <input type="text" name="q" placeholder="Search utensils…" value="<%= q %>">
  <button class="btn" type="submit">Search</button>
</form>

<div class="chips">
  <a class="chip <%= activeCategory === '' ? 'active' : '' %>" href="/shop">All</a>
  <% categories.forEach((c) => { %>
    <a class="chip <%= activeCategory === c ? 'active' : '' %>" href="/shop?category=<%= encodeURIComponent(c) %>"><%= c %></a>
  <% }) %>
</div>

<% if (categoryGroups.length) { %>
  <div class="category-sections">
    <% categoryGroups.forEach((group) => { %>
      <section class="category-section" id="category-<%= group.name.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
        <div class="category-heading">
          <div>
            <h2><%= group.name %></h2>
            <span class="category-count"><%= group.products.length %> products</span>
          </div>
          <a class="link-btn" href="/shop?category=<%= encodeURIComponent(group.name) %>">Shop this category &rarr;</a>
        </div>
        <div class="product-grid">
          <% group.products.forEach((product) => { %>
            <%- include('partials/product-card', { product }) %>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </div>
<% } else { %>
  <div class="product-grid">
    <% products.forEach((product) => { %>
      <%- include('partials/product-card', { product }) %>
    <% }) %>
  </div>
<% } %>

<% if (!products.length) { %><p class="empty">No products found. Try a different search.</p><% } %>

<%- include('partials/footer') %>
