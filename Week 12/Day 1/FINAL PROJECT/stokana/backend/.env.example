# ------------------------------------------------------------
# STOKANA environment configuration
# Copy to .env and fill in your PostgreSQL credentials.
# Never commit the real .env file.
# ------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# PostgreSQL (create the database first: createdb stokana_db)
DATABASE_URL=postgres://postgres:2632008Teff@localhost:5432/stokana_db
PGSSL=false

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=false

# Payments
# "simulated" works without provider credentials. Use "mpesa" to enable Daraja STK Push.
PAYMENT_PROVIDER=simulated
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS endpoint; Safaricom must be able to reach it.
MPESA_CALLBACK_URL=

# Optional Cloudinary image storage. Without it, uploads are stored in
# backend/uploads and served locally (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stokana/products
