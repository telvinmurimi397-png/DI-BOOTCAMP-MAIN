# ------------------------------------------------------------
# STOKANA environment configuration
# Copy to .env and fill in your PostgreSQL credentials.
# Never commit the real .env file.
# ------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# PostgreSQL (create the database first: createdb stokana_db)
DATABASE_URL=postgres://postgres:2632008Teff@localhost:5432/stokana_db
PGSSL=false

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=false

# Account verification and password recovery delivery (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox

# Payments
# M-PESA Daraja STK Push is the supported payment method.
# Set PAYMENT_PROVIDER=simulated only for local development and smoke tests.
PAYMENT_PROVIDER=mpesa
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS endpoint; Safaricom must be able to reach it.
MPESA_CALLBACK_URL=

# Optional Cloudinary image storage. Without it, uploads are stored in
# backend/uploads and served locally (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stokana/products
