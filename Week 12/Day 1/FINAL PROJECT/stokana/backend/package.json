{
  "name": "stokana-backend",
  "version": "1.0.0",
  "description": "STOKANA multi-vendor marketplace API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "db:schema": "psql \"$DATABASE_URL\" -f ../database/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f ../database/seeds/dev_seed.sql",
    "admin:bootstrap": "node scripts/bootstrap-admin.js",
    "test:smoke": "node tests/smoke.test.js",
    "test:mpesa": "node --test tests/mpesa.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
